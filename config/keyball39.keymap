#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRETY";
            bindings = <
&kp Q         &kp W     &kp E                     &kp R  &kp T                                       &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A         &kp S     &kp D                     &kp F  &kp G                                       &kp H          &kp J  &kp K      &kp L    &mt SEMI COLON
&kp Z         &kp X     &kp C                     &kp V  &kp B                                       &kp N          &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_GUI  &kp LALT  &mt LS(LEFT_COMMAND) TAB  &to 1  &mt LEFT_SHIFT MINUS  &kp SPACE  &kp ENTER  &kp BACKSPACE                             &mt ESCAPE CAPS
            >;
        };

        number_layer {
            label = "123";
            bindings = <
&none   &kp PLUS  &kp MINUS       &kp ASTERISK    &kp SLASH                        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp BACKSPACE  &kp EQUAL
&none   &none     &none           &kp UP_ARROW    &none                            &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp COMMA      &kp COLON
&none   &none     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW                  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD     &kp SLASH
&trans  &trans    &trans          &tog 2          &trans           &trans  &trans  &kp NUMBER_0                                             &to 0
            >;
        };

        symbol_layer {
            label = "!@#$%";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&none            &none        &none     &none       &none                        &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&none            &none        &none     &none       &none                        &kp UNDERSCORE  &kp PLUS       &kp COMMA         &kp PERIOD            &kp NON_US_BACKSLASH
&trans           &trans       &trans    &to 3       &trans       &trans  &trans  &kp BACKSPACE                                                          &to 0
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&none       &none           &kp UP_ARROW    &msc SCRL_LEFT  &msc SCRL_RIGHT                  &none   &none      &none      &none      &none
&none       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT       &kp PAGE_UP                      &none   &mkp LCLK  &mkp MCLK  &mkp RCLK  &kp LS(LC(LG(NUMBER_4)))
&kp K_REDO  &kp K_CUT       &kp K_COPY      &kp K_PASTE     &kp PAGE_DOWN                    &none   &none      &none      &none      &none
&trans      &trans          &trans          &to 4           &trans           &trans  &trans  &trans                                   &to 0
            >;
        };

        function_layer {
            label = "F1 F2 F3";
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &none                   &none   &none  &none  &none  &none
&kp F5  &kp F6   &kp F7   &kp F8   &none                   &none   &none  &none  &none  &none
&kp F9  &kp F10  &kp F11  &kp F12  &none                   &none   &none  &none  &none  &none
&trans  &trans   &trans   &to 5    &trans  &trans  &trans  &trans                       &trans
            >;
        };

        BT_layer {
            label = "BT";
            bindings = <
&bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none  &none                   &none   &none  &none  &none  &none
&none         &none         &none         &none  &none                   &none   &none  &none  &none  &none
&none         &none         &none         &none  &none                   &none   &none  &none  &none  &none
&none         &none         &none         &to 6  &trans  &trans  &trans  &trans                       &to 0
            >;
        };

        RGB_layer {
            label = "RGB";
            bindings = <
&rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR                  &bl BL_TOG  &bl BL_INC  &bl BL_DEC  &none  &none
&none            &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD                  &none       &none       &none       &none  &none
&none            &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &none            &none                            &none       &none       &none       &none  &none
&trans           &trans           &trans           &to 0            &trans           &trans  &trans  &trans                                     &to 0
            >;
        };
    };
};
